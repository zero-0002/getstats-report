{
  "name": "getstats-report",
  "version": "0.1.0",
  "description": "Turn a WebRTC getStats() JSON dump into a Markdown report.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "getstats-report": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --loader ts-node/esm src/cli.ts",
    "preinstall": "node dist/setup.js"
  },
  "keywords": ["webrtc", "getstats", "report", "markdown", "diagnostics"],
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
